
p, q = 61, 53
n = p * q
phi = (p-1) * (q-1)
e = 17
d = pow(e, -1, phi)

msg = "HI"

encrypted = [pow(ord(ch), e, n) for ch in msg]
decrypted = "".join(chr(pow(c, d, n)) for c in encrypted)

print("Public Key:", (e, n))
print("Private Key:", (d, n))
print("Original:", msg)
print("Encrypted:", encrypted)
print("Decrypted:", decrypted)
